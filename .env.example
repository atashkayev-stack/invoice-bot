# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Database: выбери ОДИН вариант ──

# Вариант A: Supabase (облако)
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_key

# Вариант B: Локальный PostgreSQL (рекомендуется для self-hosted)
DATABASE_URL=postgresql://bot:changeme@db:5432/invoice_bot
POSTGRES_PASSWORD=changeme

# Email (SMTP)
SMTP_SERVER=smtps.udag.de
SMTP_PORT=465
SMTP_EMAIL=your_email@domain.de
SMTP_PASSWORD=your_password

# Stripe (добавим позже)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Environment
ENVIRONMENT=production
